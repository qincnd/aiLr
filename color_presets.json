{
  "version": "2.0",
  "presets": [
    {
      "id": "film-portrait",
      "name": "胶片暖调人像",
      "tags": ["人像", "婚礼", "日常"],
      "default_intensity": 0.8,
      "summary": "暖调肤色、微微褪色的阴影与轻颗粒，适合日常与婚礼照片。",
      "prompt": {
        "steps": [
          "高光加暖，阴影稍微抬起并带轻微褪色感",
          "整体饱和度降低，保留衣服和背景色彩层次",
          "加少量颗粒和轻微暗角"
        ],
        "constraints": [
          "肤色干净通透带奶油感，避免发黄发橙",
          "脸颊和额头必须保留细节"
        ],
        "params_hint": {
          "highlights": "+5~+10",
          "shadows": "+15~+25",
          "grain": "10~15",
          "saturation": "-10~-15"
        }
      }
    },
    {
      "id": "natural-landscape",
      "name": "自然通透风光",
      "tags": ["风光", "旅行"],
      "default_intensity": 1.0,
      "summary": "白平衡准确、天空有层次、绿色不过饱和的自然风光。",
      "prompt": {
        "steps": [
          "先校正白平衡至准确中性",
          "收回高光保留云层层次，提起阴影让暗部有细节",
          "压实黑场，适当增加清晰度和少量去朦胧",
          "绿色与蓝色饱和度克制调整"
        ],
        "constraints": [
          "避免整体过饱和",
          "天空不能出现色块断层"
        ],
        "params_hint": {
          "clarity": "+10~+20",
          "dehaze": "+5~+10",
          "green_sat": "-10~-20",
          "blue_sat": "-5~-10"
        }
      }
    },
    {
      "id": "japanese-fresh",
      "name": "日系清新",
      "tags": ["日常", "人像", "少女感"],
      "default_intensity": 0.7,
      "summary": "高调明亮、低对比、淡青绿，适合生活与少女感人像。",
      "prompt": {
        "steps": [
          "曝光略微提升，阴影提起",
          "降低对比度让画面柔和",
          "白平衡稍偏冷带一点青绿",
          "饱和度整体降低，保留淡雅花草颜色",
          "清晰度略微降低"
        ],
        "constraints": [
          "肤色干净白皙不发红",
          "避免过曝和灰雾感"
        ],
        "params_hint": {
          "exposure": "+0.3~+0.7",
          "contrast": "-10~-20",
          "temp": "-3~-5",
          "clarity": "-5~-10"
        }
      }
    },
    {
      "id": "cinematic-teal-orange",
      "name": "电影感青橙",
      "tags": ["风格化", "人像", "旅拍"],
      "default_intensity": 0.6,
      "summary": "阴影青蓝、高光暖橙，压得住画面同时保住肤色。",
      "prompt": {
        "steps": [
          "颜色分级：阴影推青蓝、高光推暖橙",
          "中间调保持中性",
          "对比适中并稍微压高光，压实黑场保留暗部细节",
          "饱和度整体略降"
        ],
        "constraints": [
          "肤色不发绿不发紫",
          "必要时用混色器单独微调橙色和肤色"
        ],
        "params_hint": {
          "shadow_tint": "青蓝 220°~240°",
          "highlight_tint": "暖橙 30°~45°",
          "saturation": "-5~-10"
        }
      }
    },
    {
      "id": "mono-documentary",
      "name": "黑白纪实",
      "tags": ["风格化", "纪实", "街拍"],
      "default_intensity": 1.0,
      "summary": "转黑白后强化质感与轮廓，用暗角收束视线。",
      "prompt": {
        "steps": [
          "转换为黑白",
          "强化纹理与清晰度",
          "对比度适中偏强，阴影压深保留暗部层次",
          "加轻微暗角收拢视线"
        ],
        "constraints": [
          "主体与背景灰度要拉开距离",
          "避免死黑和硬边光晕",
          "必要时做少量降噪"
        ],
        "params_hint": {
          "contrast": "+15~+25",
          "texture": "+10~+20",
          "vignette": "-5~-10"
        }
      }
    },
    {
      "id": "vintage-sepia",
      "name": "复古暖褐",
      "tags": ["风格化", "复古", "人像"],
      "default_intensity": 0.7,
      "summary": "暖黄褐色调、褪色感与颗粒，像一张旧照片。",
      "prompt": {
        "steps": [
          "整体色调偏暖黄褐",
          "阴影抬起带褪色感，高光加暖",
          "分离色调：阴影暖褐、高光淡黄",
          "加少量颗粒和暗角"
        ],
        "constraints": [
          "饱和度降低但保留红黄厚度",
          "避免画面发脏或肤色偏土黄",
          "对比度不要过强"
        ],
        "params_hint": {
          "shadow_tint": "暖褐 35°~45°",
          "highlight_tint": "淡黄 50°~60°",
          "grain": "15~25",
          "contrast": "-5~-10"
        }
      }
    },
    {
      "id": "cool-editorial",
      "name": "冷调高级灰",
      "tags": ["商业", "产品", "建筑"],
      "default_intensity": 0.9,
      "summary": "冷白平衡、低饱和、干净的灰调，适合产品与建筑。",
      "prompt": {
        "steps": [
          "白平衡稍微偏冷",
          "整体饱和度明显降低做成低饱和灰调",
          "对比度适中偏低，阴影略带青灰",
          "适当锐化提升质感"
        ],
        "constraints": [
          "高光干净不透白，白色和灰色层次要保留",
          "避免画面发闷、发绿或出现色彩断层"
        ],
        "params_hint": {
          "temp": "-5~-8",
          "saturation": "-25~-35",
          "contrast": "-5~-10",
          "sharpening": "+15~+25"
        }
      }
    },
    {
      "id": "moody-dark",
      "name": "暗调情绪",
      "tags": ["氛围", "夜景", "雨天"],
      "default_intensity": 0.8,
      "summary": "压低曝光与黑场，冷暗色调，适合夜景与雨天。",
      "prompt": {
        "steps": [
          "曝光稍微压低，黑场压实",
          "对比度提高让光影更集中",
          "阴影推冷蓝、高光保持中性偏暖",
          "只在主体关键颜色上保留饱和度",
          "加轻微暗角"
        ],
        "constraints": [
          "主体暗部仍要看得清",
          "避免大面积死黑和噪点被放大"
        ],
        "params_hint": {
          "exposure": "-0.3~-0.7",
          "blacks": "-10~-20",
          "shadow_tint": "冷蓝 210°~230°",
          "vignette": "-8~-15"
        }
      }
    },
    {
      "id": "neon-nightscape",
      "name": "霓虹夜景",
      "tags": ["夜景", "城市", "赛博朋克"],
      "default_intensity": 0.7,
      "summary": "高饱和霓虹色、深邃暗部、光晕柔和，适合城市夜景与灯光场景。",
      "prompt": {
        "steps": [
          "压低曝光和黑场让夜空纯净",
          "单独提升红色、蓝色、紫色饱和度",
          "高光微降防止灯光过曝溢出",
          "加微量柔光效果让霓虹灯晕染自然"
        ],
        "constraints": [
          "暗部不能出现彩色噪点",
          "灯光边缘不能有生硬锯齿",
          "肤色若入镜需单独还原"
        ],
        "params_hint": {
          "exposure": "-0.5~-1.0",
          "red_sat": "+20~+30",
          "blue_sat": "+15~+25",
          "purple_sat": "+15~+25",
          "highlights": "-10~-20"
        }
      }
    },
    {
      "id": "food-warm-appetizing",
      "name": "美食暖调",
      "tags": ["美食", "商业", "日常"],
      "default_intensity": 0.9,
      "summary": "暖黄高光、食材质感突出、色彩鲜活但不失真，适合菜品与烘焙。",
      "prompt": {
        "steps": [
          "白平衡偏暖，高光加淡黄",
          "提升橙色和黄色饱和度让食物更诱人",
          "增加纹理和清晰度突出食材细节",
          "阴影微提保留餐具和桌面层次"
        ],
        "constraints": [
          "绿色蔬菜不能发黄发枯",
          "白色餐具不能偏色",
          "避免过度锐化导致油光过重"
        ],
        "params_hint": {
          "temp": "+3~+6",
          "orange_sat": "+10~+20",
          "yellow_sat": "+5~+15",
          "texture": "+15~+25",
          "shadows": "+5~+10"
        }
      }
    },
    {
      "id": "pet-soft-bright",
      "name": "宠物柔亮",
      "tags": ["宠物", "日常", "人像"],
      "default_intensity": 0.8,
      "summary": "明亮柔和、毛发细节清晰、肤色与毛色兼顾，适合猫狗宠物照。",
      "prompt": {
        "steps": [
          "曝光适中偏亮，阴影充分提起",
          "对比度降低让画面柔和不刺眼",
          "针对性提升毛发对应颜色的饱和度与清晰度",
          "白平衡保持中性偏暖"
        ],
        "constraints": [
          "眼睛必须有眼神光且不过曝",
          "鼻子和肉垫细节不能丢失",
          "避免毛发边缘出现紫边或白边"
        ],
        "params_hint": {
          "exposure": "+0.2~+0.5",
          "shadows": "+20~+30",
          "contrast": "-5~-15",
          "clarity": "+5~+10"
        }
      }
    },
    {
      "id": "street-high-contrast",
      "name": "街头硬调",
      "tags": ["街拍", "纪实", "风格化"],
      "default_intensity": 0.9,
      "summary": "高对比、浓郁色彩、光影切割感强，适合城市街头与人文抓拍。",
      "prompt": {
        "steps": [
          "对比度明显提高，黑场压实",
          "饱和度适度提升，重点强化红黄蓝三原色",
          "清晰度增加突出建筑与人物轮廓",
          "高光微压保留招牌和反光细节"
        ],
        "constraints": [
          "阴影不能完全死黑，需保留行人和街景细节",
          "避免色彩溢出导致边缘模糊",
          "人脸肤色不能因高对比而失真"
        ],
        "params_hint": {
          "contrast": "+20~+30",
          "blacks": "-5~-15",
          "clarity": "+15~+25",
          "red_sat": "+10~+15",
          "yellow_sat": "+10~+15",
          "blue_sat": "+10~+15"
        }
      }
    }
  ]
}